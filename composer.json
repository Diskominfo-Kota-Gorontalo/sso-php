{
    "name": "gorontalokota/sso-php",
    "description": "Client OpenID Connect SSO Pemerintah Kota Gorontalo untuk PHP 8.1+ (PHP native, CodeIgniter, dan dasar paket Laravel).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sso",
        "oidc",
        "openid-connect",
        "oauth2",
        "gorontalo"
    ],
    "homepage": "https://github.com/Diskominfo-Kota-Gorontalo/SSO-SDK",
    "support": {
        "issues": "https://github.com/Diskominfo-Kota-Gorontalo/SSO-SDK/issues",
        "source": "https://github.com/Diskominfo-Kota-Gorontalo/SSO-SDK"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Gorontalokota\\Sso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gorontalokota\\Sso\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
